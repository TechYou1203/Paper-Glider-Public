# Gemini API Key (optional — not currently used by the game)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Neon PostgreSQL connection string
# Get yours at https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/paper_glider?sslmode=require"

# Server port for the Express API
SERVER_PORT=3001

# App URL (for production)
APP_URL="http://localhost:3000"

# Firebase Authentication & Firestore Config
# Create a free project at https://console.firebase.google.com
# Go to Project Settings -> General -> Your Apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
