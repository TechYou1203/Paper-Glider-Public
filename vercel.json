{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/leaderboard(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/flights/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/challenges(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/inventory/(.*)",
      "destination": "/api"
    }
  ]
}
